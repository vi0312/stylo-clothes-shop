NODE_ENV=development
PORT=8787
DATABASE_URL="mysql://stylo:stylo@127.0.0.1:3306/stylo"
PUBLIC_BASE_URL="http://127.0.0.1:8787"
JWT_ACCESS_SECRET="dev-access-secret-change-me"
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
PAYMENT_PROVIDER=MOCK
SHIPPING_FEE=30000
# Subtotal from which shipping is waived; 0 disables the waiver.
FREE_SHIPPING_THRESHOLD=500000
LOW_STOCK_THRESHOLD=5
UPLOAD_DIR=uploads
SEED_ADMIN_EMAIL=admin@stylo.local
SEED_ADMIN_PASSWORD=Admin@12345
SEED_ADMIN_NAME="Stylo Admin"
# VNPay sandbox: register at https://sandbox.vnpayment.vn/devreg, then set both values and
# switch PAYMENT_PROVIDER to VNPAY. IPN needs a public URL, so the local demo settles at return.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_IP_ADDR=127.0.0.1
